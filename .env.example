# Copy to .env and fill in. .env is git-ignored.

# IBKR paper trading login (from Client Portal > Settings > Paper Trading Account)
TWS_USERID=
TWS_PASSWORD=

# Optional: password to watch the Gateway via VNC on 127.0.0.1:5900
VNC_SERVER_PASSWORD=

# Needed for new entries (Claude's view) and for --query/--cli.
ANTHROPIC_API_KEY=

# The bot starts in dry run: it does everything except send orders.
# Set to false once you've watched a day of dry-run logs.
DRY_RUN=true

# Optional: financialmodelingprep.com key for the CLI's quote/economic calendar tools
QUOTES_API_KEY=

# Phone notifications: install the ntfy app, subscribe to a hard-to-guess topic
# name, and put the same name here.
NTFY_TOPIC=

# Optional dead-man's switch: a healthchecks.io (or similar) ping URL. The bot
# pings it every 5 minutes during US market hours; set the check's schedule to
# match so you're alerted if the PC or bot stops.
HEARTBEAT_URL=

# true for debug logs
VERBOSE=false
