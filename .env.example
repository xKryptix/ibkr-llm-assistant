# Copy to .env and fill in. .env is git-ignored.

# IBKR paper trading login (from Client Portal > Settings > Paper Trading Account)
TWS_USERID=
TWS_PASSWORD=

# Optional: password to watch the Gateway via VNC on 127.0.0.1:5900
VNC_SERVER_PASSWORD=

# Needed for new entries (Claude's view) and for --query/--cli.
ANTHROPIC_API_KEY=

# The bot starts in dry run: it does everything except send orders.
# Set to false once you've watched a day of dry-run logs.
DRY_RUN=true

# Optional: financialmodelingprep.com key for the CLI's quote/economic calendar tools
QUOTES_API_KEY=

# true for debug logs
VERBOSE=false
